# Copy to .env.local for local development. In production set these in
# Vercel -> Project -> Settings -> Environment Variables (Production and Preview).
# Never commit real values; this repo is public.

# Neon Postgres, pooled connection string. Keep sslmode=require (it verifies
# the certificate). Use a fresh branch for v2; see docs/PRODUCTION_READINESS.md.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs the session JWTs. Generate with: openssl rand -base64 32
# (NEXTAUTH_SECRET is also accepted for older setups.)
AUTH_SECRET=

# Optional: residents' code required to register. Share it in the building
# group chat. Unset = anyone can register.
SIGNUP_INVITE_CODE=

# Optional: Discord channel webhook that gets a message per feedback submission.
FEEDBACK_WEBHOOK_URL=
